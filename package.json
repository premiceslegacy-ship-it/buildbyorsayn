{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000 -H 127.0.0.1",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:rls": "tsx scripts/verify-progress-rls.ts",
    "test:accompaniment-access": "tsx scripts/verify-accompaniment-access.ts",
    "lint": "tsc --noEmit",
    "skills:sync": "tsx scripts/sync-skills-to-supabase.ts",
    "stripe:pricing": "tsx --env-file=.env.local scripts/update-stripe-pricing.ts",
    "knowledge:sync": "tsx scripts/ingest-knowledge.ts",
    "knowledge:sync:apply": "tsx scripts/ingest-knowledge.ts --apply",
    "test:mcp-access": "tsx scripts/verify-mcp-access.ts",
    "test:mcp-e2e": "npm run build && tsx scripts/verify-mcp-e2e.ts && tsx scripts/verify-mcp-e2e.ts && tsx scripts/verify-mcp-e2e.ts",
    "test:mcp-tiers": "tsx scripts/verify-mcp-tier-evidence.ts",
    "test:mcp-postgres": "node scripts/verify-mcp-postgres-gates.mjs",
    "verify:release": "npm test && npm run lint && npm audit --omit=dev --audit-level=high && npm run knowledge:sync && npm run test:mcp-postgres && npm run test:mcp-postgres && npm run test:mcp-access && npm run test:mcp-e2e && npm run test:mcp-tiers && git diff --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@google/genai": "1.52.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.98.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "16.3.4",
    "protobufjs": "7.6.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.12.0",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.14.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.21",
    "browserslist": "^4.28.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "16.3.4",
    "postcss": "8.5.26",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "6.4.3"
  }
}
