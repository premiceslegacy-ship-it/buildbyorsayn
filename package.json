{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev -p 3000 -H 127.0.0.1",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "test": "node --import tsx --test --test-concurrency=1 tests/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:build-sync-live": "node --env-file=.env.e2e.local scripts/verify-build-sync-live.mjs",
    "verify:build-conveyor": "node scripts/verify-build-conveyor-flow.mjs",
    "bench:doctrine": "tsx --env-file=.env.local scripts/bench-doctrine-read.ts",
    "test:rls": "tsx scripts/verify-progress-rls.ts",
    "test:accompaniment-access": "tsx scripts/verify-accompaniment-access.ts",
    "test:stripe-upgrade-postgres": "node scripts/verify-stripe-upgrade-postgres.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --pretty false",
    "doctrine:publish": "tsx scripts/publish-doctrine.ts",
    "skills:sync": "tsx scripts/sync-skills-to-supabase.ts",
    "build-skills": "node public/build-sync/build.mjs skills",
    "stripe:pricing": "tsx --env-file=.env.local scripts/update-stripe-pricing.ts",
    "knowledge:sync": "tsx scripts/ingest-knowledge.ts",
    "knowledge:sync:apply": "tsx scripts/ingest-knowledge.ts --apply",
    "test:mcp-access": "tsx scripts/verify-mcp-access.ts",
    "test:mcp-e2e": "tsx scripts/verify-mcp-e2e.ts && tsx scripts/verify-mcp-e2e.ts && tsx scripts/verify-mcp-e2e.ts",
    "test:mcp-tiers": "tsx scripts/verify-mcp-tier-evidence.ts",
    "test:mcp-postgres": "node scripts/verify-mcp-postgres-gates.mjs",
    "test:youtube-events-postgres": "node scripts/verify-youtube-event-ordering-postgres.mjs",
    "verify:release": "npm test && npm run lint && npm run typecheck && npm run verify:production-env && npm run verify:legal-entity && npm run domain:check && npm run copy:check -- --strict && npm audit --omit=dev --audit-level=high && npm run verify:stripe-pricing && npm run test:stripe-upgrade-postgres && npm run test:youtube-events-postgres && npm run knowledge:sync && npm run test:mcp-postgres && npm run test:mcp-access && npm run build && npm run test:e2e && npm run test:mcp-e2e && npm run content:private-check && npm run test:mcp-tiers && git diff --check",
    "youtube:backfill": "tsx --env-file=.env.local scripts/youtube-backfill.ts",
    "mux:import": "tsx --env-file=.env.local scripts/mux-import-lesson.ts",
    "mux:restriction": "tsx --env-file=.env.local scripts/mux-create-restriction.ts",
    "test:nouveautes-rls": "tsx scripts/verify-nouveautes-rls.ts",
    "verify:video-env": "tsx scripts/verify-video-env.ts",
    "verify:legal-entity": "tsx scripts/verify-legal-entity.ts",
    "verify:production-env": "tsx scripts/verify-production-env.ts --production",
    "domain:check": "tsx scripts/check-domain-references.ts",
    "verify:stripe-pricing": "tsx scripts/verify-stripe-pricing.ts",
    "backfill:stripe-ledger": "tsx scripts/backfill-stripe-ledger.ts",
    "copy:check": "tsx scripts/check-copy.ts",
    "content:private-check": "tsx scripts/check-private-content.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mux/mux-player": "^3.14.0",
    "@mux/mux-player-react": "^3.14.0",
    "@mux/ts": "^15.6.1",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.98.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "esbuild": "0.27.2",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^16.4.2",
    "playwright": "^1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0",
    "yaml": "^2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.14.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "postcss": "8.5.26",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
