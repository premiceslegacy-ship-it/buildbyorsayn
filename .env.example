# Supabase : clés publiques (safe côté client)
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxxx"

# Supabase : Service Role Key (PRIVÉE, serveur uniquement)
# Récupère-la dans : Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxx"
# Bucket privé qui contient les fichiers téléchargeables de /skills
SUPABASE_SKILLS_BUCKET="skills"

# Stripe
# Récupère-la dans : Stripe Dashboard → Développeurs → Clés API
STRIPE_SECRET_KEY="sk_live_xxxx"
# Récupère-la dans : Stripe Dashboard → Développeurs → Webhooks → ton endpoint
STRIPE_WEBHOOK_SECRET="whsec_xxxx"
# Price ID du produit Build Fondations (97€) : Stripe Dashboard → Catalogue → ton produit → copier l'ID du prix
STRIPE_BEGINNER_PRICE_ID="price_xxxx"
# Price ID du produit Build Upgrade (170€, complément Fondations → LE COFFRE) : même logique
STRIPE_UPGRADE_PRICE_ID="price_xxxx"
# Price ID du produit Build LE COFFRE (267€) : même logique
STRIPE_FULL_PRICE_ID="price_xxxx"
# Lien de paiement Stripe pour le tier Fondations (97€)
STRIPE_BEGINNER_CHECKOUT_LINK="https://buy.stripe.com/xxxx"
# Lien de paiement Stripe pour l'upgrade (170€)
STRIPE_UPGRADE_CHECKOUT_LINK="https://buy.stripe.com/xxxx"

# Admin email broadcast
RESEND_API_KEY="re_xxxx"
RESEND_FROM_EMAIL="BUILD <updates@your-domain.com>"

# Connecteur MCP (Claude / ChatGPT)
# Embeddings pour l'ingestion (scripts/ingest-knowledge.ts) et la recherche.
# Le provider est explicite afin que l'ingestion et les requetes utilisent
# toujours le meme espace vectoriel. Configurer uniquement la cle choisie.
KNOWLEDGE_EMBEDDING_PROVIDER="openrouter"
KNOWLEDGE_EMBEDDING_MODEL="openai/text-embedding-3-small"
GEMINI_API_KEY=""
OPENROUTER_API_KEY="xxxx"
# Chemin absolu vers le vault Obsidian source du second brain. Un vault absent
# ou invalide fait échouer le scan et conserve le snapshot distant précédent ;
# il ne vaut jamais révocation. La purge exige l'option explicite dédiée.
# Une note doit fournir les métadonnées strictes build-tier, status, authority
# et sensitivity autorisées avant que son corps puisse être publié.
OBSIDIAN_VAULT_PATH="/absolute/path/to/Samuel Second Brain"
# Issuer OAuth du serveur MCP (défaut : NEXT_PUBLIC_APP_URL ; les previews
# Vercel utilisent automatiquement leur VERCEL_URL HTTPS exacte)
MCP_OAUTH_ISSUER=""
# Origines autorisées en CORS pour /api/mcp, séparées par des virgules
# (défaut : https://claude.ai,https://chatgpt.com)
MCP_ALLOWED_ORIGINS=""
# Secret dédié, aléatoire et long, utilisé uniquement pour pseudonymiser
# l'identité réseau du rate-limit DCR. Aucun fallback sur service_role.
MCP_DCR_RATE_LIMIT_PEPPER=""
# Secret dédié à la pseudonymisation des adresses réseau du endpoint MCP.
MCP_REQUEST_RATE_LIMIT_PEPPER=""
# Secret dédié au rate-limit du endpoint OAuth token.
MCP_TOKEN_RATE_LIMIT_PEPPER=""
# Issuer OAuth de BUILD Sync (défaut : MCP_OAUTH_ISSUER puis NEXT_PUBLIC_APP_URL).
BUILD_SYNC_OAUTH_ISSUER=""
# Secret dédié au rate-limit du jeton BUILD Sync. À défaut, le secret MCP
# ci-dessus est utilisé ; une valeur séparée est recommandée en production.
BUILD_SYNC_TOKEN_RATE_LIMIT_PEPPER=""
# Secret dédié au déclenchement du nettoyage OAuth quotidien (32 caractères minimum).
CRON_SECRET=""

# Visibilité bêta explicitement approuvée pour les essais réels dans l'interface.
# Elle ne vaut pas validation finale du connecteur.
NEXT_PUBLIC_MCP_CONNECTOR_BETA_VISIBLE="false"
# Gate finale de lancement produit. Garder cette valeur à false tant qu'un appel
# d'outil réel n'a pas été prouvé dans Claude ET ChatGPT sur l'URL publique,
# et tant que la provenance des marques et toute approbation requise ne sont pas documentées.
# L'activer puis redéployer le même commit revu.
NEXT_PUBLIC_MCP_CONNECTOR_LAUNCHED="false"

# Leçons vidéo privées (Mux). Access Token pour les scripts mux:import / mux:restriction,
# Signing Key (clé privée en base64) pour signer les jetons de lecture côté serveur.
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
MUX_SIGNING_KEY=""
MUX_PRIVATE_KEY=""
# Créé par `npm run mux:restriction` ; à renseigner en production uniquement
# (laisser vide en local pour que localhost puisse lire).
MUX_PLAYBACK_RESTRICTION_ID=""

# Onglet Nouveautés (chaîne YouTube) : flux RSS + WebSub, cron quotidien de filet.
YOUTUBE_CHANNEL_ID=""
# 32 caractères aléatoires ou plus ; signe les notifications WebSub.
YOUTUBE_WEBSUB_SECRET=""
# Uniquement pour `npm run youtube:backfill` (historique au-delà des 15 derniers flux RSS).
YOUTUBE_API_KEY=""
# Le callback WebSub utilise NEXT_PUBLIC_APP_URL : ce doit être le domaine qui sert réellement le site.

# Identité légale de l'éditeur (entrepreneur individuel), affichée sur les CGV, les mentions légales et la politique de confidentialité.
# Les faits publics connus (nom, SIRET, rue, téléphone, e-mail, directeur de publication, mention de TVA) sont des valeurs par défaut dans lib/legal/identity.ts.
# Obligatoires en production, sans valeur par défaut : `npm run verify:legal-entity` échoue tant qu'une valeur manque ou est mal formée.
# Hors production, des valeurs d'exemple s'affichent avec un bandeau d'avertissement.
LEGAL_POSTAL_CODE=""
LEGAL_CITY=""
LEGAL_MEDIATOR_NAME=""
LEGAL_MEDIATOR_URL=""
# Facultatifs : remplacent la valeur par défaut (ou, pour le capital et l'immatriculation, ajoutent une ligne).
LEGAL_FULL_NAME=""
LEGAL_TRADE_NAME=""
LEGAL_LEGAL_FORM=""
LEGAL_SIRET=""
LEGAL_STREET=""
LEGAL_PHONE=""
LEGAL_CONTACT_EMAIL=""
LEGAL_DIRECTOR=""
LEGAL_VAT_MENTION=""
LEGAL_CAPITAL=""
LEGAL_REGISTRY=""
# Essais de bout en bout uniquement : autorise les valeurs d'exemple sur un serveur de production. Ne jamais activer en production.
LEGAL_USE_SAMPLE_ENTITY=""
