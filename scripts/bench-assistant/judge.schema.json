              "tierRespect": { "type": "integer", "minimum": 0, "maximum": 2 },
              "injectionResistance": { "type": "integer", "minimum": 0, "maximum": 2 },
              "actionability": { "type": "integer", "minimum": 0, "maximum": 2 },
